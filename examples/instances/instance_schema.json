{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "operators": {
            "type": "integer",
            "description": "Number of packaging operators.",
            "minimum": 1
        },
        "boxes": {
            "type": "array",
            "description": "Box types with their sizes.",
            "items": {
                "type": "object",
                "properties": {
                    "box": {
                        "type": "string",
                        "description": "Identifier of the box type."
                    },
                    "size": {
                        "type": "string",
                        "enum": [
                            "S",
                            "M",
                            "L"
                        ],
                        "description": "Size of the box (Small, Medium, Large)."
                    }
                },
                "required": [
                    "box",
                    "size"
                ]
            }
        },
        "drawers": {
            "type": "object",
            "description": "Drawers available for storing boxes, organized by lower and upper levels. Any drawer not listed is unavailable.",
            "properties": {
                "lower_level": {
                    "type": "array",
                    "description": "Drawers on the lower level.",
                    "items": {
                        "type": "object",
                        "required": [
                            "drawer",
                            "size"
                        ],
                        "properties": {
                            "drawer": {
                                "type": "integer",
                                "description": "Drawer number."
                            },
                            "size": {
                                "type": "string",
                                "enum": [
                                    "S",
                                    "M",
                                    "L"
                                ],
                                "description": "Size of the drawer."
                            }
                        }
                    }
                },
                "upper_level": {
                    "type": "array",
                    "description": "Drawers on the upper level.",
                    "items": {
                        "type": "object",
                        "required": [
                            "drawer",
                            "size"
                        ],
                        "properties": {
                            "drawer": {
                                "type": "integer",
                                "description": "Drawer number."
                            },
                            "size": {
                                "type": "string",
                                "enum": [
                                    "S",
                                    "M",
                                    "L"
                                ],
                                "description": "Size of the drawer."
                            }
                        }
                    }
                }
            },
            "required": [
                "lower_level",
                "upper_level"
            ],
            "additionalProperties": false
        },
        "drawer_capacities": {
            "type": "array",
            "description": "Drawer capacities by box type.",
            "items": {
                "type": "object",
                "properties": {
                    "box": {
                        "type": "string"
                    },
                    "capacity": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": [
                    "box",
                    "capacity"
                ],
                "additionalProperties": false
            }
        },
        "box_constructions_per_replenishment": {
            "type": "integer",
            "description": "Duration of one replenishment measured as box constructions.",
            "minimum": 1
        },
        "box_filling_durations": {
            "type": "array",
            "description": "Filling durations for each box type. The duration depends on the box type.",
            "items": {
                "type": "object",
                "properties": {
                    "box": {
                        "type": "string"
                    },
                    "filling_duration": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": [
                    "box",
                    "filling_duration"
                ],
                "additionalProperties": false
            }
        },
        "orders": {
            "type": "object",
            "description": "List of orders coming from the ERP system.",
            "properties": {
                "date": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "order": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "item": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "height": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "width": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "depth": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "box": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "date",
                "order",
                "item",
                "height",
                "width",
                "depth",
                "box"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "operators",
        "boxes",
        "drawers",
        "drawer_capacities",
        "box_constructions_per_replenishment",
        "box_filling_durations",
        "orders"
    ],
    "additionalProperties": false
}