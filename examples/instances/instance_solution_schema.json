{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Solution Output Schema",
    "description": "Schema representing the output of the scheduler.",
    "type": "object",
    "properties": {
        "operators": {
            "type": "integer",
            "description": "Number of packaging operators.",
            "minimum": 1
        },
        "boxes": {
            "type": "array",
            "description": "Box types with their sizes.",
            "items": {
                "type": "object",
                "properties": {
                    "box": {
                        "type": "string",
                        "description": "Identifier of the box type."
                    },
                    "size": {
                        "type": "string",
                        "enum": [
                            "S",
                            "M",
                            "L"
                        ],
                        "description": "Size of the box (Small, Medium, Large)."
                    }
                },
                "required": [
                    "box",
                    "size"
                ]
            }
        },
        "drawers": {
            "type": "object",
            "description": "Drawers available for storing boxes, organized by lower and upper levels. Any drawer not listed is unavailable.",
            "properties": {
                "lower_level": {
                    "type": "array",
                    "description": "Drawers on the lower level.",
                    "items": {
                        "type": "object",
                        "required": [
                            "drawer",
                            "size"
                        ],
                        "properties": {
                            "drawer": {
                                "type": "integer",
                                "description": "Drawer number."
                            },
                            "size": {
                                "type": "string",
                                "enum": [
                                    "S",
                                    "M",
                                    "L"
                                ],
                                "description": "Size of the drawer."
                            }
                        }
                    }
                },
                "upper_level": {
                    "type": "array",
                    "description": "Drawers on the upper level.",
                    "items": {
                        "type": "object",
                        "required": [
                            "drawer",
                            "size"
                        ],
                        "properties": {
                            "drawer": {
                                "type": "integer",
                                "description": "Drawer number."
                            },
                            "size": {
                                "type": "string",
                                "enum": [
                                    "S",
                                    "M",
                                    "L"
                                ],
                                "description": "Size of the drawer."
                            }
                        }
                    }
                }
            },
            "required": [
                "lower_level",
                "upper_level"
            ],
            "additionalProperties": false
        },
        "drawer_capacities": {
            "type": "array",
            "description": "Drawer capacities by box type.",
            "items": {
                "type": "object",
                "properties": {
                    "box": {
                        "type": "string"
                    },
                    "capacity": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": [
                    "box",
                    "capacity"
                ],
                "additionalProperties": false
            }
        },
        "box_constructions_per_replenishment": {
            "type": "integer",
            "description": "Duration of one replenishment measured as box constructions.",
            "minimum": 1
        },
        "box_filling_durations": {
            "type": "array",
            "description": "Filling durations for each box type. The duration depends on the box type.",
            "items": {
                "type": "object",
                "properties": {
                    "box": {
                        "type": "string"
                    },
                    "filling_duration": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": [
                    "box",
                    "filling_duration"
                ],
                "additionalProperties": false
            }
        },
        "minimum_remaining_boxes": {
            "type": "integer",
            "description": "Minimum number of boxes to keep in drawers for each box type to ensure robustness.",
            "minimum": 0
        },
        "orders": {
            "type": "object",
            "description": "List of orders coming from the ERP system.",
            "properties": {
                "date": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "order": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "item": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "height": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "width": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "depth": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "box": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "date",
                "order",
                "item",
                "height",
                "width",
                "depth",
                "box"
            ],
            "additionalProperties": false
        },
        "operator_order_lists": {
            "type": "array",
            "description": "List of orders assigned to each operator.",
            "items": {
                "type": "object",
                "properties": {
                    "operator": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Operator ID."
                    },
                    "orders": {
                        "type": "array",
                        "description": "List of orders assigned to the operator.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer",
                                    "description": "Order ID."
                                },
                                "box": {
                                    "type": "string",
                                    "description": "Box type defined in the order."
                                }
                            },
                            "required": [
                                "id",
                                "box"
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "required": [
                    "operator",
                    "orders"
                ],
                "additionalProperties": false
            }
        },
        "is_solution_optimal": {
            "type": "boolean",
            "description": "Boolean flag indicating if the solution found is optimal (true) or just feasible (false)."
        },
        "drawer_box_mapping": {
            "type": "array",
            "description": "List mapping each drawer to its assigned box type.",
            "items": {
                "type": "object",
                "properties": {
                    "drawer": {
                        "type": "integer",
                        "description": "Drawer ID."
                    },
                    "box": {
                        "type": "string",
                        "description": "Box type."
                    }
                },
                "required": [
                    "drawer",
                    "box"
                ],
                "additionalProperties": false
            }
        },
        "replenishments": {
            "type": "array",
            "description": "List of replenishment activities.",
            "items": {
                "type": "object",
                "properties": {
                    "drawer": {
                        "type": "integer",
                        "description": "Drawer in which replenishment occurs."
                    },
                    "box": {
                        "type": "string",
                        "description": "Type of box replenished."
                    },
                    "order_id": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The replenishment starts when the filling operator processes the order with this ID."
                    }
                },
                "required": [
                    "drawer",
                    "box",
                    "order_id"
                ],
                "additionalProperties": false
            }
        },
        "box_constructions": {
            "type": "array",
            "description": "List of drawers used for box construction activities.",
            "items": {
                "type": "integer",
                "description": "Drawer ID."
            }
        },
        "solver": {
            "type": "object",
            "description": "Metadata and statistics from the scheduler.",
            "properties": {
                "objective_value": {
                    "type": "number",
                    "description": "Final objective value achieved by the solver."
                },
                "best_objective_bound": {
                    "type": "number",
                    "description": "Best bound for the objective value."
                },
                "user_time": {
                    "type": "number",
                    "description": "Total time taken by the solver to compute the solution (in seconds)."
                }
            },
            "required": [
                "objective_value",
                "best_objective_bound",
                "user_time"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "operators",
        "boxes",
        "drawers",
        "drawer_capacities",
        "box_constructions_per_replenishment",
        "box_filling_durations",
        "minimum_remaining_boxes",
        "orders",
        "operator_order_lists",
        "is_solution_optimal",
        "drawer_box_mapping",
        "replenishments",
        "box_constructions",
        "solver"
    ],
    "additionalProperties": false
}